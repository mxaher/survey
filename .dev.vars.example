# Cloudflare Workers local development secrets
# Copy this file to .dev.vars and fill in the values
# NEVER commit .dev.vars to version control

# HMAC secret for employee identity hashing
# In production, set via: wrangler secret put EMPLOYEE_HMAC_SECRET
EMPLOYEE_HMAC_SECRET=

# Admin session signing secret
# In production, set via: wrangler secret put ADMIN_AUTH_SECRET
ADMIN_AUTH_SECRET=

# Email for employee self-registration (verification links)
# Provider: set RESEND_API_KEY (primary) or MAILJET_API_KEY + MAILJET_SECRET_KEY
RESEND_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Verified sender address, e.g. survey@almarshad.com
EMAIL_FROM=
EMAIL_FROM_NAME=
